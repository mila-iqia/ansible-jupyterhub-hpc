---

# These are global variables that are used across roles.

# ---------------------------------------------------
# SSL certificates configuration
# ---------------------------------------------------

# Boolean. To be set to true if we are using self signed
# certificates for all components which includes juoyterhub,
# prometheus, grafana, node_exporter, nginx_exporter. If we 
# use certificates from external CA, we need to set this to false
# CURRENTLY THERE IS NO SUPPORT TO USE SELF SIGNED CERTIFICATES
# FOR SOME COMPONENTS AND CA CERTIFICATES FOR OTHERS. EITHER
# USE ONE OR OTHER
self_signed_certs: true

# In the case of self signed certificates, we need CA certificate
# bundle for verification. We place all CA certificates here.
# This folder will have relaxed permissions of 0755 so that 
# others can read the certificates. If we are using certificates
# from external CA, this variable will be unused
remote_path_ca_cert_ssl: "/etc/ssl/ca"

# ---------------------------------------------------
# Local paths to find tokens, passwords and SSL stuff
# ---------------------------------------------------

# Path to find the encryption related data
local_path_encryption_data: "{{ lookup('env','PWD') }}/encryption"

# Path to find the SSL certificates on ansible host machine
local_path_ssl: "{{ local_path_encryption_data }}/ssl"

# Path to find tokens on ansible host
local_path_tokens: "{{ local_path_encryption_data }}/tokens"


# ---------------------------------------------------
# Nginx SSL certs local path
# ---------------------------------------------------

# Path where all certificates related to nginx reverse proxy
# will be placed on local ansible host
local_path_nginx_proxy_ssl: "{{ local_path_ssl }}/nginx"

# SSL key and certificate names
ssl_cert_key_prefix_nginx_proxy: "nginx"
ssl_key_name_nginx_proxy: "{{ ssl_cert_key_prefix_nginx_proxy }}.key"
ssl_cert_name_nginx_proxy: "{{ ssl_cert_key_prefix_nginx_proxy }}.crt"
ssl_dhparam_name_nginx_proxy: "{{ ssl_cert_key_prefix_nginx_proxy }}.dhparam.pem"


# ---------------------------------------------------
# Node exporter SSL certs local path
# ---------------------------------------------------

# Path where all certificates related to node exporter
# will be placed on local ansible host
local_path_node_exporter_ssl: "{{ local_path_ssl }}/node_exporter"

# SSL key and certificate names
ssl_cert_key_prefix_node_exporter: "node_exporter"
ssl_key_name_node_exporter: "{{ ssl_cert_key_prefix_node_exporter }}.key"
ssl_cert_name_node_exporter: "{{ ssl_cert_key_prefix_node_exporter }}.crt"


# ---------------------------------------------------
# Prometheus SSL certs local path
# ---------------------------------------------------

# Path where all certificates related to prometheus SSL
# will be placed on local ansible host
local_path_prometheus_ssl: "{{ local_path_ssl }}/prometheus"

# SSL key and certificate names
ssl_cert_key_prefix_prometheus: "prometheus"
ssl_key_name_prometheus: "{{ ssl_cert_key_prefix_prometheus }}.key"
ssl_cert_name_prometheus: "{{ ssl_cert_key_prefix_prometheus }}.crt"


# ---------------------------------------------------
# Grafana SSL certs local path
# ---------------------------------------------------

# Path where all certificates related to prometheus SSL
# will be placed on local ansible host
local_path_grafana_ssl: "{{ local_path_ssl }}/grafana"

# SSL key and certificate names
ssl_cert_key_prefix_grafana: "grafana"
ssl_key_name_grafana: "{{ ssl_cert_key_prefix_grafana }}.key"
ssl_cert_name_grafana: "{{ ssl_cert_key_prefix_grafana }}.crt"
