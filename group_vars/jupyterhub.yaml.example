---

# These are global variables that are used across roles.

# ---------------------------------------------------
# conda related configuration
# ---------------------------------------------------

# Python version to be used in the conda environment
conda_env_py_version: "3.8"

# All the packages related to jupyterhub deployment will be installed
# within an conda environment. This variable controls where we want to
# install this environment. By default conda tends to install the 
# environment at <conda_prefix>/envs/<myenv>. This might not be a suitable
# location for some deployments where the admins would want this environment
# on shared file system. We can use this variable to set the location of 
# environment
jupyter_env_prefix: "/opt/jupyter"

# Name of the jupyterhub conda environment
jupyter_env_name: "jupyterhub-{{ jupyterhub_version }}"

# Jupyterhub environment prefix. Do not need to change normally.
jupyterhub_env_prefix: "{{ jupyter_env_prefix }}/{{ jupyter_env_name }}"

# Path to binaries inside the jupyterhub environment
jupyterhub_env_bin_path: "{{ jupyterhub_env_prefix }}/bin"

# ---------------------------------------------------
# HPC platform related configuration
# ---------------------------------------------------

# Path to SLURM binaries like sbatch, squeue, scancel
# We run the jupyterhub service as a normal system user without any sudo
# rights by default. However we need to use sudo to change the context for
# submitting jobs as different user. So we need add SLURM commands to list of
# commands that service account can use without password prompt.
# More details can be found here: 
# https://jupyterhub.readthedocs.io/en/stable/reference/config-sudo.html
#
# We need to add these binaries to jupyter service user sudoers entry so that
# jupyter service user can spawn jupyter servers on the behalf of the users
# If SLURM commands like sbatch is located at /usr/bin/sbatch we need to
# set this variable as /usr/bin
# Although we can use Ansible find module to get this dynamically it might
# pose few issues depending on platforms. 
slurm_bin_path: "/usr/bin"

# To reduce the brute force attacks we can check ths user names with regex
# pattern before attempting to authenticate via SSH.
valid_username_regex: ''

# ---------------------------------------------------
# JupyterHub service user
# ---------------------------------------------------

# Name of the user under which JupyterHub will be running. This user will be
# added to sudoers group but the user will be allowed to use sudo for only
# spawning the servers using batch spawner. By default this user will not have
# login shell and home directory
jupyterhub_service_user: "jupyter"

# ---------------------------------------------------
# JupyterHub config directories
# ---------------------------------------------------

# This is the directory where we store the HTML templates, internal certs
# created by jupyterhub for SSL. It should be writable by jupyterhub_service_user
jupyterhub_srv_dir: "/srv/jupyterhub"

# Directory where jupyterhub logs are redirected
jupyterhub_log_dir: "/var/log/jupyterhub"

# Directory where internal certificates are stored
jupyterhub_internal_certs_dir: "{{ jupyterhub_srv_dir }}/internal-ssl"

# Directory where user spawning preferences are stored as JSON files
jupyterhub_user_spawn_profiles_dir: "{{ jupyterhub_srv_dir }}/user-spawn-profiles"

# Directory where jupyterhub configuration files are placed
jupyterhub_config_dir: "{{ jupyterhub_env_prefix }}/etc/jupyterhub"

# ---------------------------------------------------
# JupyterHub Database configuration
# ---------------------------------------------------

# We will PostgresSql data base for jupyterhub. We will configure
# the database name here
jupyterhub_db_name: "jupyterhub"

# ---------------------------------------------------
# Jupyter config directories
# ---------------------------------------------------

# Directory where jupyter notebook configuration files are placed
jupyter_config_dir: "{{ jupyterhub_env_prefix }}/etc/jupyter"

# Directories to share and templates for notebook servers
jupyter_share_dir: "{{ jupyterhub_env_prefix }}/share/jupyter"
jupyter_templates_dir: "{{ jupyter_config_dir }}/templates"

# ---------------------------------------------------
# IPython config directory
# ---------------------------------------------------

# Directory where IPython configuration files are placed
ipython_config_dir: "{{ jupyterhub_env_prefix }}/etc/ipython"

# ---------------------------------------------------
# List of administrators
# ---------------------------------------------------

# List of admin users for jupyterhub
jupyterhub_admin_users: []
  