---

# All node exporter related configuration
# NORMALLY THERE IS NO NEED TO CHANGE THESE VARIABLES

# ---------------------------------------------------
# node exporter configuration
# ---------------------------------------------------

# Internal variables of node exporter play
_node_exporter_system_group: "node-exp"
_node_exporter_system_user: "{{ _node_exporter_system_group }}"

# Node exporter URL
node_exporter_port: "9100"
node_exporter_address: "{{ inventory_hostname }}"
node_exporter_web_listen_address: "{{ node_exporter_address }}:{{ node_exporter_port }}"

# Path to store the SSL certificates on remote machine
remote_path_node_exporter_ssl: "/etc/node_exporter/ssl"

# TLS config
node_exporter_tls_server_config:
  cert_file: "{{ remote_path_node_exporter_ssl }}/{{ ssl_cert_name_node_exporter }}"
  key_file: "{{ remote_path_node_exporter_ssl }}/{{ ssl_key_name_node_exporter }}"

# Basic auth config
node_exporter_basic_auth_users:
  node_exporter: "{{ lookup('env','JP_NODE_EXPORTER_PASSWD') }}"
