# WARNING: This file is {{ ansible_managed }}, do not modify it
# Jupyterhub systemd service config

[Unit]
Description=Service for launching Jupyterhub
After=network-online.target remote-fs.target local-fs.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple

EnvironmentFile=/etc/sysconfig/jupyterhub

User={{ jupyterhub_service_user }}
Group={{ jupyterhub_service_user }}

RuntimeDirectory=jupyterhub
LogsDirectory=jupyterhub
CacheDirectory=jupyterhub
ConfigurationDirectory=jupyterhub

ExecStart={{ jupyterhub_env_bin_path }}/jupyterhub -f {{ jupyterhub_config_dir }}/jupyterhub_config.py

Restart=always
RestartSec=5

StandardOutput=append:{{ jupyterhub_log_dir }}/jupyterhub.log
StandardError=append:{{ jupyterhub_log_dir }}/jupyterhub.log


[Install]
WantedBy=multi-user.target