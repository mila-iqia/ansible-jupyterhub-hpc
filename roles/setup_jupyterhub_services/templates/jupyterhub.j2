# List of env variables that will be used in systemd service for jupyterhub

# TODO: We are hard coding this path. Is it good idea? No. Lets keep it like this for the
# moment and find an elegant solution later
PATH={{ jupyterhub_env_bin_path }}:{{ lookup('env', 'PATH') }}

# Crypt keys that hub will rotate
JUPYTERHUB_CRYPT_KEY={{ lookup('file', '{{ local_path_tokens }}/crypt_key') }}