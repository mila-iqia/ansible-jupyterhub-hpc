# WARNING: This file is {{ ansible_managed }}, do not modify.

server {
    listen {{ nginx_http_port }};
    listen [::]:{{ nginx_http_port }};
    server_name {{ jupyterhub_service_name }};

    # Tell all requests to HTTP port to be 302 redirected to HTTPS
    return 302 https://$host$request_uri;
}

server {
    listen {{ nginx_https_port }} ssl;
    client_max_body_size 500M;
    server_name {{ jupyterhub_service_name }};
    
    location / {
        proxy_pass http://{{ jupyterhub_hub_ip | default(ansible_all_ipv4_addresses[0], true) }}:8000;

        proxy_set_header X-Real-IP $remote_addr;
    {% if nginx_https_port == '443' %}
        proxy_set_header Host $host;
    {% else %}
        proxy_set_header Host $http_host;
    {% endif %}
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-NginX-Proxy true;

        # websocket headers
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Scheme $scheme;

        proxy_buffering off;
    }
}
