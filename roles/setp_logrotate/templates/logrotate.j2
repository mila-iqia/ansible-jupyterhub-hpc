# WARNING: This file is {{ ansible_managed }}, do not modify.
# Config file for logrotate.

{% for log in item.log_files %}
/var/log/{{ item.service_name }}/{{ log }}
{% endfor %}
{
   weekly
   rotate 4
   size 50M
   dateext
   compress
   delaycompress
   missingok
   notifempty
   sharedscripts
{% if item.service_name == 'jupyterhub' or item.service_name == 'jupyterhub-proxy' %}
   copytruncate
{% else %}
   create {{ item.mode }} {{ item.user }} {{ item.group }}
   postrotate
    {{ item.postrotate }}
 endscript
{% endif %}
}

