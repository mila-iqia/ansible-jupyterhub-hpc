# Systemd unit file for loki

[Unit]
Description=Loki Log Aggregator
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/loki -config.file "{{ loki_config_directory }}/loki.yml"
Restart=always
RestartSec=10
User={{ loki_system_user }}
Group={{ loki_system_group }}
StandardOutput=file:/var/log/loki/loki.log
StandardError=file:/var/log/loki/loki.log
Environment=SYSTEMD_LOG_LEVEL=debug

[Install]
WantedBy=multi-user.target