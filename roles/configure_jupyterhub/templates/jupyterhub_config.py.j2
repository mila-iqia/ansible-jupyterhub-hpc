# WARNING: This file is {{ ansible_managed }}, do not modify.
# Configuration file for jupyterhub.

import os
c = get_config()

## Set the log level by value or name.
c.Application.log_level = 10

## Allow named single-user servers per user
c.JupyterHub.allow_named_servers = True

## Maximum number of concurrent named servers that can be created by a user at a
#  time.
#
#  Setting this can limit the total resources a user can consume.
#
#  If set to 0, no limit is enforced.
c.JupyterHub.named_server_limit_per_user = 10

## The ip address for the Hub process to *bind* to.
#
#  By default, the hub listens on localhost only. This address must be accessible
#  from the proxy and user servers. You may need to set this to a public ip or ''
#  for all interfaces if the proxy or user servers are in containers or on a
#  different host.
#
#  See `hub_connect_ip` for cases where the bind and connect address should
#  differ, or `hub_bind_url` for setting the full bind URL.
c.JupyterHub.hub_connect_ip = '{{ inventory_hostname }}'

## Class for authenticating users.
c.JupyterHub.authenticator_class = 'sshauthenticator.SSHAuthenticator'
c.Authenticator.manage_groups = True
c.SSHAuthenticator.default_group_name = "default"
c.SSHAuthenticator.server_address = '{{ groups["sshauth_node"][0] }}'

# Seems like jinja2 always returns string. We typecast it to int 
c.SSHAuthenticator.server_port = {{ sshauth_port | int }}
c.SSHAuthenticator.valid_username_regex = {{ valid_username_regex }}

## Number of days for a login cookie to be valid. Default is two weeks.
c.JupyterHub.cookie_max_age_days = 7

# The command to start the http proxy.
#
# Only override if configurable-http-proxy is not on your PATH
c.ConfigurableHTTPProxy.command = ['{{ jupyterhub_env_bin_path }}/configurable-http-proxy']

## File in which to store the cookie secret.
c.JupyterHub.cookie_secret_file = '{{ jupyterhub_srv_dir }}/cookie_secret'
c.ConfigurableHTTPProxy.auth_token = '{{ jupyterhub_srv_dir }}/proxy_auth_token'
c.ConfigurableHTTPProxy.debug = True

## The location of jupyterhub data files (e.g. /usr/local/share/jupyterhub)
c.JupyterHub.data_files_path = '{{ jupyterhub_env_prefix }}/share/jupyterhub'

## url for the database. e.g. `sqlite:///jupyterhub.sqlite`
c.JupyterHub.db_url = '{{ jupyterhub_srv_dir }}/jupyterhub.sqlite'

## If named servers are enabled, default name of server to spawn or open, e.g. by
#  user-redirect.
c.JupyterHub.default_server_name = 'jupyter'

## Enable SSL for all internal communication
#
#  This enables end-to-end encryption between all JupyterHub components.
#  JupyterHub will automatically create the necessary certificate authority and
#  sign notebook certificates as they're created.
c.JupyterHub.internal_ssl = True

## The location to store certificates automatically created by JupyterHub.
#
#  Use with internal_ssl
c.JupyterHub.internal_certs_location = '{{ jupyterhub_internal_certs_dir }}'

## Names to include in the subject alternative name.
#
#  These names will be used for server name verification. This is useful if
#  JupyterHub is being run behind a reverse proxy or services using ssl are on
#  different hosts.
#
#  Use with internal_ssl
{% if groups['compute'] | length %}
c.JupyterHub.trusted_alt_names = [
{%- for node in groups['compute'] -%}
'DNS:{{ node }}',
{%- endfor -%}
'DNS:{{ inventory_hostname }}',
'IP:{{ ansible_default_ipv4.address }}']
{% else %}
c.JupyterHub.trusted_alt_names = []
{% endif %}

## File to write PID Useful for daemonizing JupyterHub.
c.JupyterHub.pid_file = '{{ jupyterhub_srv_dir }}/pid'
c.ConfigurableHTTPProxy.pid_file = '{{ jupyterhub_srv_dir }}/proxy_pid'

## The default URL for users when they arrive (e.g. when user directs to "/")
#
#  By default, redirects users to their own server.
def default_url_fn(handler):
    user = handler.current_user
    if user and user.admin:
       return '/hub/admin'
    return '/hub/home'
c.JupyterHub.default_url = default_url_fn


## The class to use for spawning single-user servers.
#
#          Should be a subclass of :class:`jupyterhub.spawner.Spawner`.
#
#          .. versionchanged:: 1.0
#              spawners may be registered via entry points,
#              e.g. `c.JupyterHub.spawner_class = 'localprocess'`
#
#  Currently installed:
#    - default: jupyterhub.spawner.LocalProcessSpawner
#    - localprocess: jupyterhub.spawner.LocalProcessSpawner
#    - simple: jupyterhub.spawner.SimpleLocalProcessSpawner
# 
# import jupyter_slurm_spawner
# c.JupyterHub.spawner_class = 'jupyter_slurm_spawner.JeanZaySlurmSpawner'
from jupyter_slurm_spawner import JeanZaySlurmSpawner
from cdsdashboards.hubextension.spawners.variablemixin import VariableMixin, MetaVariableMixin

class VariableSlurmSpawner(JeanZaySlurmSpawner, VariableMixin, metaclass=MetaVariableMixin):
    pass
    
c.JupyterHub.spawner_class = VariableSlurmSpawner

# Path where jupyterhub binaries are installed
c.JeanZaySlurmSpawner.req_jupyter_bin_path = '{{ jupyterhub_env_bin_path }}'

# Location to store user spawning preferences as profiles in JSON format
c.JeanZaySlurmSpawner.user_spawn_profiles_location = '{{ jupyterhub_user_spawn_profiles_dir }}'

# Path where Xeus Cling binaries are installed
{% if install_cpp_kernel == true %}
c.JeanZaySlurmSpawner.req_cling_bin_path = '{{ cling_pkg_path }}/bin'
{% endif %}

# Path where julia binaries are installed
{% if install_julia_kernel == true %}
c.JeanZaySlurmSpawner.req_julia_bin_path = '{{ julia_pkg_path }}/bin'
{% endif %}

# Path where R binaries are installed
{% if install_r_kernel == true %}
c.JeanZaySlurmSpawner.req_r_bin_path = '{{ rlang_pkg_path }}/bin'
{% endif %}

# Placeholder for home directory
c.JeanZaySlurmSpawner.homedir_prefix = '{{ user_homedir }}'

# Command to launch jupyterhub singleuser server
c.Spawner.cmd = ['jupyterhub-singleuser']

# Increase spawner timeout to be tolerant of longer queue wait times.
c.Spawner.http_timeout = 300
c.Spawner.start_timeout = 300

## Maximum number of consecutive failures to allow before shutting down
#  JupyterHub.
#
#  This helps JupyterHub recover from a certain class of problem preventing
#  launch in contexts where the Hub is automatically restarted (e.g. systemd,
#  docker, kubernetes).
#
#  A limit of 0 means no limit and consecutive failures will not be tracked.
c.Spawner.consecutive_failure_limit = 2

## Enable debug-logging of the single-user server
c.Spawner.debug = True

## The URL the single-user server should start in.
#
#  `{username}` will be expanded to the user's username
#
#  Example uses:
#
#  - You can set `notebook_dir` to `/` and `default_url` to `/tree/home/{username}` to allow people to
#    navigate the whole filesystem from their notebook server, but still start in their home directory.
#  - Start with `/notebooks` instead of `/tree` if `default_url` points to a notebook instead of a directory.
#  - You can set this to `/lab` to have JupyterLab start by default, rather than Jupyter Notebook.
c.Spawner.default_url = '/tree/home/{username}'

## Path to the notebook directory for the single-user server.
#
#  The user sees a file listing of this directory when the notebook interface is
#  started. The current interface does not easily allow browsing beyond the
#  subdirectories in this directory's tree.
#
#  `~` will be expanded to the home directory of the user, and {username} will be
#  replaced with the name of the user.
#
#  Note that this does *not* prevent users from accessing files outside of this
#  path! They can do so with many other means.
c.Spawner.notebook_dir = '~'

## List of environment variables for the single-user server to inherit from the
#  JupyterHub process.
#
#  This list is used to ensure that sensitive information in the JupyterHub
#  process's environment (such as `CONFIGPROXY_AUTH_TOKEN`) is not passed to the
#  single-user server's process.
c.Spawner.env_keep = ['LANG', 'LC_ALL', 'JUPYTERHUB_SINGLEUSER_APP']

#------------------------------------------------------------------------------
# Authenticator(LoggingConfigurable) configuration
#------------------------------------------------------------------------------

## Base class for implementing an authentication provider for JupyterHub

## Set of users that will have admin rights on this JupyterHub.
#
#  Note: As of JupyterHub 2.0, full admin rights should not be required, and more
#  precise permissions can be managed via roles.
#
#  Admin users have extra privileges:
#   - Use the admin panel to see list of users logged in
#   - Add / remove users in some authenticators
#   - Restart / halt the hub
#   - Start / stop users' single-user servers
#   - Can access each individual users' single-user server (if configured)
#
#  Admin access should be treated the same way root access is.
#
#  Defaults to an empty set, in which case no user has admin access.
{% if jupyterhub_admin_users | length %}
c.Authenticator.admin_users = {
{%- for user in jupyterhub_admin_users[:-1] -%}
'{{user}}',
{%- endfor -%}
'{{-jupyterhub_admin_users[-1]-}}'}
{% else %}
c.Authenticator.admin_users = set()
{% endif %}

## Enable persisting auth_state (if available).
#
#  auth_state will be encrypted and stored in the Hub's database. This can
#  include things like authentication tokens, etc. to be passed to Spawners as
#  environment variables.
#
#  Encrypting auth_state requires the cryptography package.
#
#  Additionally, the JUPYTERHUB_CRYPT_KEY environment variable must contain one
#  (or more, separated by ;) 32B encryption keys. These can be either base64 or
#  hex-encoded.
#
#  If encryption is unavailable, auth_state cannot be persisted.
#
#  New in JupyterHub 0.8
c.Authenticator.enable_auth_state = True

#------------------------------------------------------------------------------
# LaTeX configuration
#------------------------------------------------------------------------------

## The extension defaults to running xelatex. We set it to pdflatex here
c.LatexConfig.latex_command = 'pdflatex'

#------------------------------------------------------------------------------
# CDS Dashboards configuration
#------------------------------------------------------------------------------

# More info on CDS dashboards configuration can be obtained at 
# https://cdsdashboards.readthedocs.io/en/stable/chapters/setup/localprocess.html

# This is the startup command to launch dashboard server
c.VariableMixin.default_presentation_cmd = ['jhsingle-native-proxy']

# These are complementary configuration that CDS dashboard Spawner needs
c.CDSDashboardsConfig.builder_class = 'cdsdashboards.builder.processbuilder.ProcessBuilder'

from cdsdashboards.app import CDS_TEMPLATE_PATHS
from cdsdashboards.hubextension import cds_extra_handlers

c.JupyterHub.template_paths = CDS_TEMPLATE_PATHS
c.JupyterHub.extra_handlers = cds_extra_handlers


# Control whether ‘All Users’ or ‘Selected Users’ is selected by default on the ‘New Dashboard’ page.
# By default, ‘All Users’ will be selected.
c.CDSDashboardsConfig.default_allow_all = False

# Do not allow to setup custom conda environments
# We let the users to use dashboards only in the given conda environment
c.CDSDashboardsConfig.allow_custom_conda_env = False

# Let users to be presented with spawner form to setup spawning options
c.CDSDashboardsConfig.spawn_default_options = False

# Add a role for CDS dashboards for default group of users
# This is needed for users to be able to share dashboards
c.JupyterHub.load_roles = [
    {
        "name": "cdsdashboards",
        "description": "access servers",
        "scopes": [
            "access:servers"
        ],
        "groups": [
            "default"
        ]
    },
]


#------------------------------------------------------------------------------
# Prometheus metrics configuration
#------------------------------------------------------------------------------

# We need a token to get prometheus metrics that are exposed by JupyterHub
metrics_token_path = '{{ jupyterhub_srv_dir }}/metrics_token'
metrics_token = open(metrics_token_path, 'r').read().strip()

# Create a service to scrape prometheus metrics
c.JupyterHub.services = [
    {
        "name": "service-prometheus",
        "api_token": metrics_token,
    },
]

# Add a service role to scrape prometheus metrics
c.JupyterHub.load_roles += [
    {
        "name": "service-metrics-role",
        "description": "access metrics",
        "scopes": [
            "read:metrics",
        ],
        "services": [
            "service-prometheus",
        ],
    }
]
